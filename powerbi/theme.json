{
  "name": "CogniStream Power BI",
  "dataColors": [
    "#118DFF",
    "#12239E",
    "#E66C37",
    "#6B007B",
    "#E044A7",
    "#744EC2",
    "#D9B300",
    "#D64550"
  ],
  "foreground": "#252423",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F2F1",
  "backgroundNeutral": "#E1DFDD",
  "tableAccent": "#118DFF",
  "good": "#2BA84A",
  "neutral": "#F2C811",
  "bad": "#D64550",
  "maximum": "#118DFF",
  "center": "#F2C811",
  "minimum": "#D64550",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 28,
      "fontColor": "#252423"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "fontColor": "#252423"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 12,
      "fontColor": "#605E5C"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "fontColor": "#605E5C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{
          "show": true,
          "color": { "solid": { "color": "#E1DFDD" } },
          "radius": 4
        }],
        "visualHeader": [{
          "foreground": { "solid": { "color": "#252423" } }
        }]
      }
    },
    "card": {
      "*": {
        "labels": [{
          "fontFamily": "Segoe UI",
          "fontSize": 12,
          "color": { "solid": { "color": "#605E5C" } }
        }],
        "categoryLabels": [{
          "fontFamily": "Segoe UI",
          "fontSize": 12,
          "color": { "solid": { "color": "#605E5C" } }
        }],
        "calloutValue": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 28,
          "color": { "solid": { "color": "#252423" } }
        }]
      }
    },
    "gauge": {
      "*": {
        "axis": [{
          "min": 0,
          "max": 100
        }]
      }
    }
  }
}
