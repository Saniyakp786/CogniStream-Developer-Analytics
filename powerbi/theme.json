{
  "name": "CogniStream Power BI",
  "dataColors": [
    "#118DFF",
    "#12239E",
    "#744EC2",
    "#E66C37",
    "#E044A7",
    "#6B007B",
    "#D9B300",
    "#D64550"
  ],
  "foreground": "#252423",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F2F1",
  "backgroundNeutral": "#E1DFDD",
  "tableAccent": "#118DFF",
  "good": "#2BA84A",
  "neutral": "#F2C811",
  "bad": "#D64550",
  "maximum": "#118DFF",
  "center": "#F2C811",
  "minimum": "#D64550",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 28,
      "fontColor": "#252423"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "fontColor": "#252423"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 12,
      "fontColor": "#605E5C"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "fontColor": "#605E5C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "radius": 4
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#252423"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#605E5C"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#605E5C"
              }
            }
          }
        ],
        "calloutValue": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#252423"
              }
            }
          }
        ]
      }
    },
    "gauge": {
      "*": {
        "axis": [
          {
            "min": 0,
            "max": 100
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F2F1"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E1DFDD"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ]
      }
    }
  }
}
